# Default: SQLite (no Docker required). Swap to Postgres after `make up`.
DATABASE_URL=sqlite:///data/store.db
# DATABASE_URL=postgresql://sqlagent:sqlagent@127.0.0.1:5432/sqlagent

POSTGRES_USER=sqlagent
POSTGRES_PASSWORD=sqlagent
POSTGRES_DB=sqlagent
POSTGRES_PORT=5432

# LLM (first key found wins: Groq -> Gemini -> OpenAI -> Ollama)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Local models via Ollama (no cloud key). Example: gemma4:e4b, llama3.2
USE_OLLAMA=0
OLLAMA_MODEL=llama3.2

# Optional Mem0 cloud. If empty, a local SQLite memory store is used.
MEM0_API_KEY=

# Eval / agent
AGENT_USER_ID=demo_user
MAX_RETRIES=3
STATEMENT_TIMEOUT_MS=5000
